# Copy to .env for local `netlify dev`. Never commit the real .env.
# In production these are set in the Netlify dashboard:
#   Site settings -> Environment variables

# Google Gemini — powers the AI scene assistant (netlify/functions/assistant.js)
GEMINI_API_KEY=

# ElevenLabs — optional high-quality TTS (netlify/functions/tts.js).
# The app defaults to the browser's built-in Web Speech voice; ElevenLabs is
# only used when the client TTS_ENGINE setting is switched to "elevenlabs".
ELEVENLABS_API_KEY=
